rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read only their own profile. Writes are reserved to the
    // Stripe webhook, which uses the Admin SDK and bypasses these rules.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
